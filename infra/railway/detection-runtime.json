{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/detection-runtime.Dockerfile",
    "watchPatterns": [".railway-manual-only"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  },
  "environmentVariables": {
    "RULES_DIR": "/rules",
    "RISINGWAVE_HOST": "risingwave.railway.internal",
    "RISINGWAVE_PORT": "4566",
    "KAFKA_BROKERS": "redpanda.railway.internal:9092",
    "ALERTS_TOPIC": "alerts",
    "POLL_INTERVAL_SECS": "2",
    "RUST_LOG": "info"
  }
}
