{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/workbench-api.Dockerfile",
    "watchPatterns": [".railway-manual-only"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/healthz"
  },
  "environmentVariables": {
    "WORKBENCH_API_PORT": "4400",
    "PORT": "4400",
    "ATTEST_LOG_PATH": "/data/attestations.ndjson",
    "RUST_LOG": "info"
  }
}
