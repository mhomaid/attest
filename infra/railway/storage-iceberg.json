{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/storage-iceberg.Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  },
  "environmentVariables": {
    "KAFKA_BROKERS": "redpanda.railway.internal:9092",
    "KAFKA_TOPIC": "cloudtrail",
    "KAFKA_GROUP_ID": "attest-iceberg-writer",
    "S3_ENDPOINT": "http://minio.railway.internal:9000",
    "S3_BUCKET": "attest-warm",
    "S3_ACCESS_KEY": "minioadmin",
    "S3_SECRET_KEY": "minioadmin",
    "S3_REGION": "us-east-1",
    "TABLE_PREFIX": "cloudtrail",
    "BATCH_SIZE": "1000",
    "FLUSH_INTERVAL_SECS": "30",
    "RUST_LOG": "info"
  }
}
