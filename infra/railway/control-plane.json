{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/control-plane.Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health"
  },
  "environmentVariables": {
    "RISINGWAVE_HOST": "risingwave.railway.internal",
    "RISINGWAVE_PORT": "4566",
    "CLICKHOUSE_URL": "http://clickhouse.railway.internal:8123",
    "KAFKA_BROKERS": "redpanda.railway.internal:9092",
    "PORT": "8080",
    "RUST_LOG": "info"
  }
}
