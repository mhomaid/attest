{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/calibration-sidecar.Dockerfile",
    "watchPatterns": [".railway-manual-only"]
  },
  "deploy": {
    "startCommand": "python calibrate.py --serve",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/healthz"
  },
  "environmentVariables": {
    "CALIBRATION_PORT": "5001",
    "PORT": "5001",
    "ARTIFACTS_DIR": "/app/artifacts",
    "PYTHONUNBUFFERED": "1"
  }
}
