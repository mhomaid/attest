{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd apps/workbench && bun run start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  },
  "environmentVariables": {
    "NIXPACKS_NODE_VERSION": "20",
    "CONTROL_PLANE_URL": "https://${{ControlPlane.RAILWAY_PUBLIC_DOMAIN}}",
    "ARROYO_URL": "http://${{Arroyo.RAILWAY_PRIVATE_DOMAIN}}:5115",
    "NEXT_PUBLIC_APP_URL": "https://attest-wb.up.railway.app",
    "NEXT_PUBLIC_CP_WS_URL": "wss://${{ControlPlane.RAILWAY_PUBLIC_DOMAIN}}"
  }
}
