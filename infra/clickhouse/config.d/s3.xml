<clickhouse>
    <!-- Allow s3() queries against the local Garage endpoint.
         Credentials are passed inline in queries; no named disk needed for dev.
         Region matches garage.toml (RisingWave signs as "custom"). -->
    <s3>
        <region>custom</region>
    </s3>
    <remote_url_allow_hosts>
        <host>garage</host>
        <host>localhost</host>
    </remote_url_allow_hosts>
</clickhouse>
