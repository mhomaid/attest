# OS/editor
.DS_Store
.idea/
.vscode/
# Local Cursor state. The agent workflow (rules, skills, hooks) is tracked.
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/hooks.json
docs/.$architecture-diagrams.drawio.bkp

# Node
node_modules/
.next/
out/
coverage/
!apps/workbench/src/app/workbench/coverage/
playwright-report/
test-results/
apps/workbench/tests/e2e/.auth/
*.tsbuildinfo

docs/social/*
!docs/social/.gitkeep
# Private, local-only material. The cursor pack is the source for the
# public workflow files; it stays here and is never committed.
docs/private/
docs/private/attest-public-cursor-pack/
docs/leave-behind/
docs/Attest_Product_Walkthrough.*
.attest-denylist
# Terraform plugin cache (lock files stay committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Rust
/target/
# Cargo.lock is intentionally committed — this workspace contains binary crates.

# Python
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
dist/
*.egg-info/

# Local runtime data
.env
.env.*
!.env.example
!.env.local.example
data/
tmp/

# Eval data and generated reports
eval/per_customer/*
!eval/per_customer/.gitkeep
eval/reports/*
!eval/reports/.gitkeep

# Model artifacts — not committed, except the ~12 KB triager set, which is
# deterministic from ml/triager/golden_cases.json and required by CI and the
# orchestrator / calibration-sidecar images
*.onnx
*.gguf
*.pt
*.safetensors
*.npy
*.pkl
!ml/triager/artifacts/*

# ML build artifacts
ml/.venv/
# Downloaded public datasets. Registry and data cards stay in git; bytes never do.
ml/datasets/cache/
.lighthouseci/
# Attestation logs — local run artifacts, never commit
*.ndjson
!examples/**/*.ndjson
# Scratch / debug JSON dumps
test.json
