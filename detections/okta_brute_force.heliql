detection: okta_brute_force_authentication
description: "Detects 5 or more failed Okta authentications for one user within 10 minutes."
applies_to: ocsf.authentication
where:
  - event.api_service = "okta"
entity: identity.user
condition:
  - event.auth_status = "Failure"
  - count(window: 10m) >= 5
severity: high
mitre: [T1110]
runtime: stream
