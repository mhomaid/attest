# Attest — local development environment variables
# Copy to .env and fill in the values.
# Never commit .env to git.

# ── Collector / Kafka ─────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092

# ── Control Plane ─────────────────────────────────────────────────────────────
CONTROL_PLANE_PORT=8080
POSTGRES_URL=postgres://attest:attest@localhost:5432/attest

# ── Orchestrator ──────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4300
ARTIFACTS_DIR=./ml/triager/artifacts
ESCALATION_THRESHOLD=0.60
NOVELTY_THRESHOLD=0.70

# Ed25519 signing key — generate with: openssl rand -hex 32
# ATTEST_SIGNING_KEY=<hex-encoded 32-byte seed>

# Attestation log
ATTEST_LOG_PATH=./attestations.ndjson

# ── Calibration sidecar ───────────────────────────────────────────────────────
CALIBRATION_URL=http://localhost:5001

# ── MCP Gateway ───────────────────────────────────────────────────────────────
MCP_GATEWAY_PORT=4242
MCP_GATEWAY_URL=http://localhost:4242

# ── Phase 4b — LLM Escalation ────────────────────────────────────────────────
# Choose "local" (Unsloth Studio / llama.cpp) or "anthropic"
ATTEST_LLM_PROVIDER=local

# Local OpenAI-compatible server (Unsloth Studio default)
ATTEST_LLM_BASE_URL=http://127.0.0.1:8888/v1
ATTEST_LLM_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF
# API key for Unsloth Studio (Settings → API Keys in the Studio web UI at http://127.0.0.1:8888)
# ATTEST_LLM_API_KEY=<your-unsloth-api-key>

# Optional: max LLM iterations per escalation (default 8)
# LLM_MAX_ITERATIONS=8

# Anthropic (only needed when ATTEST_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ATTEST_LLM_MODEL=claude-sonnet-4-5

# System prompt (relative to workspace root)
SYSTEM_PROMPT_PATH=./agents/triager/system_prompt_v1.md

# ── Phase 5 — Hallucination Guardrails ───────────────────────────────────────
# Set to "off" to disable all guardrail checks during local debugging.
ATTEST_GUARDRAILS=on

# Max number of re-prompts per guardrail check before forcing NeedsInvestigation.
GUARDRAIL_MAX_RETRIES=3

# Calibrated confidence above which a TruePositive verdict triggers cross-review.
CROSS_REVIEW_SEVERITY_THRESHOLD=0.85

# Reviewer system prompt path (cross-agent review; default below)
REVIEWER_PROMPT_PATH=./agents/triager/reviewer_prompt_v1.md

# ── Storage / MinIO ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=attest-warm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
