# Copy to .env.local and adjust for your environment.

# ── Local development ─────────────────────────────────────────────────────────

# Postgres for Better Auth + Kysely (either name works; DATABASE_URL is conventional).
DATABASE_URL=postgres://attest:attest@localhost:5432/attest
# POSTGRES_URL=postgres://attest:attest@localhost:5432/attest

# Better Auth — use `openssl rand -base64 32` (min 32 chars).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# URL of attest-control-plane (server-side only — no NEXT_PUBLIC_ prefix).
CONTROL_PLANE_URL=http://localhost:8080

# Same values as docker-compose.yml. Required when NODE_ENV=production; local dev falls back to these.
# ATTEST_SERVICE_AUTH_SECRET=dev-only-service-auth-secret
# ATTEST_INGEST_HMAC_SECRET=dev-only-ingest-hmac-secret

# Phase 7 — attestation trace proxy (Next.js server-side)
# WORKBENCH_API_URL=http://localhost:4400

# Next.js app origin used for internal server-side API fetches.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser: control-plane HTTP + WS (`/v1/ws/alerts`).
NEXT_PUBLIC_CP_URL=http://localhost:8080
NEXT_PUBLIC_CP_WS_URL=ws://localhost:8080

# Trace WebSocket gateway (JWT from `/api/auth/ws-token`).
NEXT_PUBLIC_WS_GATEWAY_URL=ws://localhost:4500

# Same secret as ws-gateway + Next `ws-token` route (min 32 chars in prod).
ATTEST_WS_JWT_SECRET=dev-ws-jwt-secret-change-me-min-32-chars!

# Must match docker-compose. Production sets a unique value; an empty value sends no token.
ATTEST_SERVICE_AUTH_SECRET=dev-only-service-auth-secret
ATTEST_INGEST_HMAC_SECRET=dev-only-ingest-hmac-secret

# ── Sign-in: generic OIDC (any provider with discovery, e.g. Keycloak, Okta, Entra ID) ─────
# SSO is enabled only when issuer, client ID and client secret are all set.
# Redirect URI to register at the provider: <BETTER_AUTH_URL>/api/auth/oauth2/callback/oidc
# ATTEST_OIDC_ISSUER=https://idp.example.com/realms/example
# ATTEST_OIDC_CLIENT_ID=attest-workbench
# ATTEST_OIDC_CLIENT_SECRET=
# Claim holding the role: viewer | analyst | lead | auditor. A dotted path such as
# realm_access.roles works. If several roles are present the most privileged wins
# (lead > analyst > auditor > viewer). Unknown or missing values fall back to the default role.
# ATTEST_OIDC_ROLE_CLAIM=role
# ATTEST_OIDC_DEFAULT_ROLE=viewer
# ATTEST_OIDC_SCOPES=openid profile email
# ATTEST_OIDC_DISCOVERY_URL=   # default: <issuer>/.well-known/openid-configuration
# ATTEST_OIDC_LABEL=Single sign-on   # text on the sign-in button
#
# Set to "off" to disable email/password sign-in and sign-up and the waitlist (SSO only).
# Default is on for local development; the production Helm values set it to off.
# ATTEST_AUTH_PASSWORD=off
#
# Local Keycloak for the Playwright OIDC spec (realm "example"):
#   docker run --rm -p 8080:8080 -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin \
#     -v "$PWD/infra/keycloak:/opt/keycloak/data/import:ro" quay.io/keycloak/keycloak:26.4 start-dev --import-realm
#   ATTEST_E2E_OIDC=1 bun run e2e -- --project=oidc

# Dev user analyst@attest.local / analyst-dev — create once after migrate:
#   curl -sS -X POST http://localhost:3000/api/auth/seed-analyst \
#     -H "Content-Type: application/json" \
#     -H "x-seed-secret: $AUTH_SEED_SECRET"
# Set ALLOW_AUTH_SEED=0 in production.
ALLOW_AUTH_SEED=1
AUTH_SEED_SECRET=local-dev-auth-seed-secret

# Waitlist → Resend (never commit the API key).
# RESEND_API_KEY=
# RESEND_FROM=Attest Waitlist <admin@homaid.dev>
# WAITLIST_NOTIFY_TO=mohamed@homaid.dev

# Observability is off unless both lines are set. Default is off.
# ATTEST_TELEMETRY=on
# NEXT_PUBLIC_ATTEST_TELEMETRY=on
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=

# ── Railway production (uncomment and fill in your Railway public domains) ────
#
# CONTROL_PLANE_URL=https://your-control-plane.up.railway.app
# NEXT_PUBLIC_APP_URL=https://your-workbench.up.railway.app
# NEXT_PUBLIC_CP_WS_URL=wss://your-control-plane.up.railway.app
#
# Note: use wss:// (not ws://) in production — Railway terminates TLS at the
# edge so the browser must connect over the secure WebSocket scheme.
