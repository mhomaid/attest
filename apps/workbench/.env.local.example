# Copy to .env.local and adjust for your environment.

# ── Local development ─────────────────────────────────────────────────────────

# URL of attest-control-plane (server-side only — no NEXT_PUBLIC_ prefix).
CONTROL_PLANE_URL=http://localhost:8080

# Next.js app origin used for internal server-side API fetches.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Exposed to the browser: control-plane WebSocket URL for real-time alerts.
# The hook connects to ${NEXT_PUBLIC_CP_WS_URL}/v1/ws/alerts
NEXT_PUBLIC_CP_WS_URL=ws://localhost:8080

# ── Railway production (uncomment and fill in your Railway public domains) ────
#
# CONTROL_PLANE_URL=https://your-control-plane.up.railway.app
# NEXT_PUBLIC_APP_URL=https://your-workbench.up.railway.app
# NEXT_PUBLIC_CP_WS_URL=wss://your-control-plane.up.railway.app
#
# Note: use wss:// (not ws://) in production — Railway terminates TLS at the
# edge so the browser must connect over the secure WebSocket scheme.
