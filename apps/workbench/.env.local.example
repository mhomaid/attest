# Copy to .env.local and adjust for your environment.

# ── Local development ─────────────────────────────────────────────────────────

# Postgres for Better Auth + Kysely (either name works; DATABASE_URL is conventional).
DATABASE_URL=postgres://attest:attest@localhost:5432/attest
# POSTGRES_URL=postgres://attest:attest@localhost:5432/attest

# Better Auth — use `openssl rand -base64 32` (min 32 chars).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# URL of attest-control-plane (server-side only — no NEXT_PUBLIC_ prefix).
CONTROL_PLANE_URL=http://localhost:8080
# Phase 7 — attestation trace proxy (Next.js server-side)
# WORKBENCH_API_URL=http://localhost:4400

# Next.js app origin used for internal server-side API fetches.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser: control-plane HTTP + WS (`/v1/ws/alerts`).
NEXT_PUBLIC_CP_URL=http://localhost:8080
NEXT_PUBLIC_CP_WS_URL=ws://localhost:8080

# Trace WebSocket gateway (JWT from `/api/auth/ws-token`).
NEXT_PUBLIC_WS_GATEWAY_URL=ws://localhost:4500

# Same secret as ws-gateway + Next `ws-token` route (min 32 chars in prod).
ATTEST_WS_JWT_SECRET=dev-ws-jwt-secret-change-me-min-32-chars!

# Dev user analyst@attest.local / analyst-dev — create once after migrate:
#   curl -sS -X POST http://localhost:3000/api/auth/seed-analyst \
#     -H "Content-Type: application/json" \
#     -H "x-seed-secret: $AUTH_SEED_SECRET"
# Set ALLOW_AUTH_SEED=0 in production.
ALLOW_AUTH_SEED=1
AUTH_SEED_SECRET=local-dev-auth-seed-secret

# Optional observability
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=

# ── Railway production (uncomment and fill in your Railway public domains) ────
#
# CONTROL_PLANE_URL=https://your-control-plane.up.railway.app
# NEXT_PUBLIC_APP_URL=https://your-workbench.up.railway.app
# NEXT_PUBLIC_CP_WS_URL=wss://your-control-plane.up.railway.app
#
# Note: use wss:// (not ws://) in production — Railway terminates TLS at the
# edge so the browser must connect over the secure WebSocket scheme.
