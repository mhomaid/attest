# Copy to .env in the private overlay. Local values match `make dev-up-live`.
# Replace the issuer and secrets before pointing this at a real identity provider.
ATTEST_AUTH_PASSWORD=off
ATTEST_OIDC_ISSUER=http://localhost:8180/realms/example
ATTEST_OIDC_CLIENT_ID=attest-workbench
ATTEST_OIDC_CLIENT_SECRET=e2e-client-secret
ATTEST_OIDC_ROLE_CLAIM=roles
ATTEST_SOURCE_GRAYLOG=on
ATTEST_SOURCE_EDGE=on
ATTEST_GRAYLOG_URL=http://localhost:9000
ATTEST_GRAYLOG_TOKEN=
ATTEST_POLICY_FILE=./policy.yaml
ATTEST_FIELD_MAP_FILE=./field-map.yaml
ATTEST_INGEST_HMAC_SECRET=dev-only-ingest-hmac-secret
ATTEST_SERVICE_AUTH_SECRET=dev-only-service-auth-secret
ATTEST_TOPIC_PREFIX=attest
